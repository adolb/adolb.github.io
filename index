<!-- SCRIPT PEMUTAR MUSIK -->
<script>
  const audioPlayer = document.getElementById('w2-audio-player');
  const btnPlay = document.getElementById('w2-btn-play');
  const iconPlay = document.getElementById('w2-icon-play');
  const iconPause = document.getElementById('w2-icon-pause');
  const btnPrev = document.getElementById('w2-btn-prev');
  const btnNext = document.getElementById('w2-btn-next');
  const titleEl = document.getElementById('w2-header-title');
  const artistEl = document.getElementById('w2-header-artist');
  const progressFill = document.getElementById('w2-progress-fill');
  const progressContainer = document.getElementById('w2-progress-container');
  const playlistEl = document.getElementById('w2-playlist');
  const statText = document.getElementById('w2-stat-text');
  const btnUpload = document.getElementById('w2-btn-upload');
  const fileInput = document.getElementById('w2-file-input');

  let playlist = [];
  let currentIndex = 0;

  btnUpload.addEventListener('click', () => fileInput.click());

  fileInput.addEventListener('change', (e) => {
    const files = Array.from(e.target.files);
    files.forEach(file => {
      playlist.push({
        name: file.name.replace(/\.[^/.]+$/, ""),
        url: URL.createObjectURL(file)
      });
    });
    statText.innerText = `${playlist.length} Music, 1 Album`;
    renderPlaylist();
    if (playlist.length === files.length) {
      loadTrack(0);
    }
  });

  function renderPlaylist() {
    playlistEl.innerHTML = '';
    playlist.forEach((track, index) => {
      const item = document.createElement('div');
      item.style.cssText = `padding: 8px 16px; font-size: 12px; color: ${index === currentIndex ? '#007aff' : '#444'}; font-weight: ${index === currentIndex ? '600' : 'normal'}; cursor: pointer; display: flex; justify-content: space-between; border-bottom: 1px solid #f9f9f9; background: ${index === currentIndex ? '#f0f0f5' : 'transparent'};`;
      item.innerText = track.name;
      item.addEventListener('click', () => {
        loadTrack(index);
        audioPlayer.play();
        updatePlayState(true);
      });
      playlistEl.appendChild(item);
    });
  }

  function loadTrack(index) {
    if (playlist.length === 0) return;
    currentIndex = index;
    audioPlayer.src = playlist[currentIndex].url;
    titleEl.innerText = playlist[currentIndex].name;
    artistEl.innerText = "Musik Lokal";
    renderPlaylist();
  }

  function updatePlayState(isPlaying) {
    if (isPlaying) {
      iconPlay.style.display = 'none';
      iconPause.style.display = 'block';
    } else {
      iconPlay.style.display = 'block';
      iconPause.style.display = 'none';
    }
  }

  btnPlay.addEventListener('click', () => {
    if (playlist.length === 0) return;
    if (audioPlayer.paused) {
      audioPlayer.play();
      updatePlayState(true);
    } else {
      audioPlayer.pause();
      updatePlayState(false);
    }
  });

  btnNext.addEventListener('click', () => {
    if (playlist.length === 0) return;
    currentIndex = (currentIndex + 1) % playlist.length;
    loadTrack(currentIndex);
    audioPlayer.play();
    updatePlayState(true);
  });

  btnPrev.addEventListener('click', () => {
    if (playlist.length === 0) return;
    currentIndex = (currentIndex - 1 + playlist.length) % playlist.length;
    loadTrack(currentIndex);
    audioPlayer.play();
    updatePlayState(true);
  });

  audioPlayer.addEventListener('timeupdate', () => {
    if (audioPlayer.duration) {
      const progressPercent = (audioPlayer.currentTime / audioPlayer.duration) * 100;
      progressFill.style.width = `${progressPercent}%`;
    }
  });

