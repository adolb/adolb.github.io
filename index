    function handleGlobalSearch() { 
        const query = document.getElementById('globalSearch').value.toLowerCase().trim();
        const popup = document.getElementById('searchPopup');

        // Sembunyikan popup jika input kosong
        if (query === '') {
            popup.style.display = 'none';
            return;
        }

        let results = [];
        const regexTitle = new RegExp(`(${query})`, 'gi');
        
        function highlightTitle(title) {
            if(!title) return "";
            let escaped = escapeHTML(title);
            if (escaped.toLowerCase().includes(query)) {
                return escaped.replace(regexTitle, '<strong style="color:var(--text-primary); font-weight:700;">$1</strong>');
            }
            return escaped;
        }

        // 1. Cari di Catatan
        if (currentNotesList && currentNotesList.length > 0) {
            currentNotesList.forEach((note, index) => {
                const isMatch = (note.tittle && note.tittle.toLowerCase().includes(query)) || 
                                (note.description && note.description.toLowerCase().includes(query));
                if (isMatch) {
                    let descDisplay = note.description && note.description.toLowerCase().includes(query) 
                                      ? getSnippetHighlight(note.description, query) 
                                      : (note.description ? escapeHTML(note.description.substring(0, 60)) + "..." : "");
                    results.push({ 
                        type: 'Catatan', 
                        title: highlightTitle(note.tittle), 
                        desc: descDisplay, 
                        action: `viewFullNote(${index})` 
                    });
                }
            });
        }

        // 2. Cari di Pengingat
        if (currentReminders && currentReminders.length > 0) {
            currentReminders.forEach(rem => {
                if (rem.content && rem.content.toLowerCase().includes(query)) {
                    const displayTime = rem.reminder_time ? rem.reminder_time.substring(0, 5) : "";
                    results.push({ 
                        type: 'Pengingat', 
                        title: highlightTitle(rem.content), 
                        desc: `${formatSimpleDate(rem.reminder_date)} - ${displayTime}`, 
                        action: `openViewReminder('${rem.id}')` 
                    });
                }
            });
        }

        // 3. Cari di Email
        if (typeof emailsData !== 'undefined' && emailsData.length > 0) {
            emailsData.forEach((email, index) => {
                const isMatch = (email.subject && email.subject.toLowerCase().includes(query)) || 
                                (email.sender && email.sender.toLowerCase().includes(query)) || 
                                (email.body && email.body.toLowerCase().includes(query));
                if (isMatch) {
                    let senderClean = cleanSenderName(email.sender);
                    let descDisp = `Dari: ${email.sender.toLowerCase().includes(query) ? highlightTitle(senderClean) : escapeHTML(senderClean)}`;
                    
                    if (email.body && email.body.toLowerCase().includes(query)) {
                        descDisp += `<br><span style="color:#94a3b8;">- ${getSnippetHighlight(email.body, query)}</span>`;
                    }
                    
                    results.push({ 
                        type: 'Email', 
                        title: highlightTitle(email.subject || 'Tanpa Subjek'), 
                        desc: descDisp, 
                        action: `openEmailMessage(${index})` 
                    });
                }
            });
        }
        
        // 4. Cari di Bookmark (Data yang sudah tersimpan di lokal memori via HTML)
        if (currentBookmarksList && currentBookmarksList.length > 0) {
            currentBookmarksList.forEach(bk => {
                const isMatch = (bk.nama && bk.nama.toLowerCase().includes(query)) || 
                                (bk.url && bk.url.toLowerCase().includes(query));
                if(isMatch) {
                    results.push({ 
                        type: 'Bookmark', 
                        title: highlightTitle(bk.nama), 
                        desc: bk.url.toLowerCase().includes(query) ? highlightTitle(bk.url) : escapeHTML(bk.url), 
                        action: `window.open('${bk.url}', '_blank')` 
                    });
                }
            });
        }

        // 5. Cari di Drive File (Data yang sudah tersimpan di lokal memori via HTML)
        if (currentDriveList && currentDriveList.length > 0) {
            currentDriveList.forEach(file => {
                let cleanName = file.name.substring(file.name.indexOf('_') + 1);
                if (cleanName.toLowerCase().includes(query)) {
                    results.push({
                        type: 'Drive',
                        title: highlightTitle(cleanName),
                        desc: "Klik untuk mengunduh dokumen...",
                        action: `downloadDriveFile('${file.name}', '${cleanName}')`
                    });
                }
            });
        }

        // Render hasil ke dalam Popup
        if (results.length > 0) {
            popup.innerHTML = results.map(res => `
                <div class="search-popup-item" onclick="${res.action}; document.getElementById('searchPopup').style.display='none'; document.getElementById('globalSearch').value='';">
                    <div class="search-popup-type">${res.type}</div>
                    <div class="search-popup-title">${res.title}</div>
                    <div class="search-popup-desc">${res.desc}</div>
                </div>
            `).join('');
            popup.style.display = 'flex';
        } else {
            popup.innerHTML = `<div class="search-popup-item" style="cursor: default;"><div class="search-popup-desc" style="text-align:center; padding: 10px 0;">Tidak ada hasil ditemukan</div></div>`;
            popup.style.display = 'flex';
        }
    }

