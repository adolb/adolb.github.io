        if(res){
            h.push(res); h.sort((a, b) => a.netVal - b.netVal);
            historyBoxEl.innerHTML = h.map(x => {
                let splitValues = [2, 3, 4, 5, 6].map(div => "<span>÷" + div + ":" + n(x.netVal / div) + "</span>").join(" • ");
                return "<div class='ota-hist-item'><div class='ota-hist-main'>" + n(x.inputVal) + " -> " + n(x.netVal) + " [ " + x.ota.toUpperCase() + " ]</div><div class='ota-hist-split'>" + splitValues + "</div></div>";
            }).join("");
            let currentNet = netEl.innerHTML, currentGross = grossEl.innerHTML, currentCut = cutEl.innerHTML;
            inputEl.value = ""; netEl.innerHTML = currentNet; grossEl.innerHTML = currentGross; cutEl.innerHTML = currentCut;
            statusEl.innerHTML = "🟢 Tersimpan"; statusEl.className = "ota-status ota-green";
        }
    }
    inputEl.addEventListener('input', () => { let val = c(inputEl.value), o = otaEl.value; if(val > 0) inputEl.dataset.lastVal = JSON.stringify({ netVal: (o=="traveloka") ? (val/0.82)*0.75 : val*0.88, inputVal: val, ota: o }); });
    inputEl.oninput = calcOTA; otaEl.onchange = calcOTA;

    function updateTextCharCount() { document.getElementById('textConverterFooter').innerText = `${document.getElementById('textConverterInput').value.length} Karakter`; }
    function resetTextButtonState() {
        updateTextCharCount();
        if (isTextConverterSubmitted) {
            isTextConverterSubmitted = false; document.getElementById('textActionBtn').className = "btn-teks blue-mode";
            document.getElementById('textBtnIcon').className = "fa-regular fa-copy"; document.getElementById('textBtnText').innerText = "KAPITAL & SALIN";
            document.getElementById('textStatusIndicator').style.display = 'none';
        }
    }
    async function handleTextButtonClick() {
        const inputArea = document.getElementById('textConverterInput'), btn = document.getElementById('textActionBtn'), icon = document.getElementById('textBtnIcon'), text = document.getElementById('textBtnText');
        if (!isTextConverterSubmitted) {
            const originalText = inputArea.value.trim(); if (!originalText) return;
            const uppercaseText = originalText.toUpperCase(); inputArea.value = uppercaseText; updateTextCharCount();
            try { await navigator.clipboard.writeText(uppercaseText); document.getElementById('textStatusIndicator').style.display = 'block'; isTextConverterSubmitted = true; btn.className = "btn-teks red-mode"; icon.className = "fa-solid fa-trash-can"; text.innerText = "HAPUS TEKS"; } catch (err) { alert("Gagal menyalin."); }
        } else {
            inputArea.value = ""; updateTextCharCount(); isTextConverterSubmitted = false; btn.className = "btn-teks blue-mode"; icon.className = "fa-regular fa-copy"; text.innerText = "KAPITAL & SALIN"; document.getElementById('textStatusIndicator').style.display = 'none';
        }
    }

    // =======================================================
    // --- INTEGRASI FUNGSI EMAIL ---
    // =======================================================
    let emailsData = [];
    let activeEmail = null; 

    function cleanSenderName(senderText) {
      if (!senderText) return 'Anonim';
      const match = senderText.match(/^([^<]+)/);
      return match ? match[1].trim() : senderText;
    }

    async function loadEmails() {
      const container = document.getElementById('emailListContainer');
      const footer = document.getElementById('emailFooter');
      container.innerHTML = `<div class="item-meta" style="text-align: center; padding: 20px 0;">Memuat pesan...</div>`;
      
      try {
        const { data, error } = await supabaseClient
          .from('emails')
          .select('*')
          .neq('sender', 'Google <no-reply@accounts.google.com>') 
          .order('email_id', { ascending: false }); 

        if (error) {
          container.innerHTML = `<div class="item-meta" style="text-align: center; padding: 20px 0;">Error: ${error.message}</div>`;
          return;
        }

        if (!data || data.length === 0) {
          container.innerHTML = `<div class="item-meta" style="text-align: center; padding: 20px 0;">Belum ada email baru.</div>`;
          footer.innerText = `0 Email`;
          return;
        }

        emailsData = data;

        container.innerHTML = data.map((email, index) => {
            const subjectText = escapeHTML(email.subject || 'Tanpa Subjek');
            const senderText = escapeHTML(cleanSenderName(email.sender));
            const snippetText = escapeHTML(email.body || 'Tidak ada isi').substring(0, 45) + '...';

            return `
            <div class="item-row" onclick="openEmailMessage(${index})">
                <div class="item-text-wrapper">
                    <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 8px;">
                        <div class="item-title">${subjectText}</div>
                        <div class="item-meta" style="margin-top:0;">${senderText}</div>
                    </div>
                    <div class="item-meta" style="margin-top: 4px;">${snippetText}</div>
                </div>
            </div>`;
        }).join('');
        
        footer.innerText = `${data.length} Email`;

      } catch (err) {
        console.error(err);
        container.innerHTML = `<div class="item-meta" style="text-align: center; padding: 20px 0;">Terjadi kesalahan sistem.</div>`;
      }
    }

    function openEmailMessage(index) {
      activeEmail = emailsData[index];
      if (!activeEmail) return;

      document.getElementById('modalEmailSubject').innerHTML = '<i class="fa-regular fa-envelope" style="color:#f5b031; margin-right:8px;"></i> ' + escapeHTML(activeEmail.subject || 'Tanpa Subjek');
      document.getElementById('modalEmailSender').innerHTML = 'Dari: <span style="color:var(--text-primary);">' + escapeHTML(activeEmail.sender || 'Anonim') + '</span>';
      document.getElementById('modalEmailContent').innerHTML = escapeHTML(activeEmail.body || 'Tidak ada isi pesan yang bisa ditampilkan.');

      document.getElementById('copyEmailBtn').innerHTML = '<i class="fa-regular fa-copy"></i> Salin';
      document.getElementById('emailModal').style.display = 'flex';
    }

    function closeEmailModal() {
      document.getElementById('emailModal').style.display = 'none';
      activeEmail = null;
    }

    async function copyEmailMessage() {
      if (!activeEmail) return;
      const textToCopy = activeEmail.body || 'Tidak ada isi';
      
      try {
        await navigator.clipboard.writeText(textToCopy);
        const copyBtn = document.getElementById('copyEmailBtn');
        copyBtn.innerHTML = '<i class="fa-solid fa-check"></i> Tersalin!';
        
        setTimeout(() => {
          if (copyBtn.innerText.includes('Tersalin')) {
            copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i> Salin';
          }
        }, 2000);
      } catch (err) {
        console.error('Gagal menyalin:', err);
      }
    }

    // Pasang loadEmails bersamaan saat DOM dimuat agar sinkron dengan yang lain
    window.addEventListener('DOMContentLoaded', loadEmails);

</script>

