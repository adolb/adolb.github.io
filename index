                </div>
            </div>
            
            <div class="wa-footer">
                <span id="footerLabel">Status Backup</span>
                <span class="footer-text" id="totalContactsText">0 Kontak Dibackup</span>
            </div>
        </div>
    </div>

    <script>
        const GH_USER = "adolb";
        const GH_REPO = "wa";
        
        let allChatsData = {};
        let currentView = 'contacts';
        let currentActiveContact = null;
        let targetScrollIndex = -1;
        let searchMatches = [];
        let currentMatchIndex = -1;

        function parseWATimestamp(dateStr, timeStr) {
            if (!dateStr) return 0;
            let d = dateStr.replace(/[\.\-]/g, '/').split('/');
            if (d.length !== 3) return 0;
            let day = parseInt(d[0], 10), month = parseInt(d[1], 10) - 1, year = parseInt(d[2], 10);
            if (year < 100) year += 2000;
            let hours = 0, mins = 0, secs = 0;
            if (timeStr) {
                let tStr = timeStr.toLowerCase().replace(/\./g, ':');
                let isPM = tStr.includes('pm'), isAM = tStr.includes('am');
                let tParts = tStr.replace(/[^\d:]/g, '').split(':');
                if (tParts.length >= 2) {
                    hours = parseInt(tParts[0], 10); mins = parseInt(tParts[1], 10);
                    if (tParts.length >= 3) secs = parseInt(tParts[2], 10);
                    if (isPM && hours < 12) hours += 12;
                    if (isAM && hours === 12) hours = 0;
                }
            }
            return new Date(year, month, day, hours, mins, secs).getTime();
        }

        async function initViewer() {
            const loadingEl = document.getElementById('contactLoading');
            try {
                const apiUrl = `https://api.github.com/repos/${GH_USER}/${GH_REPO}/contents/`;
                const response = await fetch(apiUrl);
                if (!response.ok) throw new Error("Gagal mengambil data");
                const files = await response.json();
                const jsonFiles = files.filter(file => file.name.endsWith('.json') && file.name !== 'package.json');
                loadingEl.style.display = 'none';
                if (jsonFiles.length === 0) {
                    loadingEl.style.display = 'block'; loadingEl.textContent = "Tidak ada file chat JSON ditemukan."; return;
                }
                for (let file of jsonFiles) {
                    fetch(file.download_url).then(res => res.json()).then(data => {
                        const displayName = file.name.replace('.json', '').replace(/^_/, '').replace(/-/g, ' ');
                        const chatList = data.chats ? data.chats : (Array.isArray(data) ? data : []);
                        allChatsData[displayName] = chatList;
                        renderContactItem(displayName, chatList);
                        updateTotalFooter();
                    }).catch(err => console.error("Error loading file:", file.name));
                }
            } catch (error) {
                loadingEl.style.display = 'block'; loadingEl.textContent = "Gagal memuat data repositori."; loadingEl.style.color = "#ff4d4d";
            }
        }

        function renderContactItem(name, chatList) {
            const listEl = document.getElementById('contactList');
            const lastMsgObj = chatList.length > 0 ? chatList[chatList.length - 1] : null;
            const lastMsg = lastMsgObj ? lastMsgObj.message : "Tidak ada pesan";
            const lastDate = lastMsgObj ? (lastMsgObj.date || '') : "";
            const lastTime = lastMsgObj ? (lastMsgObj.time || '') : "";
            const lastDateTime = [lastDate, lastTime].filter(Boolean).join(' ');

            const div = document.createElement('div');
            div.className = 'wa-contact-item';
            div.innerHTML = `
                <div class="wa-contact-name">
                    <span>${escapeHTML(name)}</span>
                    <span class="wa-contact-time">${escapeHTML(lastDateTime)}</span>
                </div>
                <div class="wa-contact-msg">${escapeHTML(lastMsg)}</div>
            `;
            div.onclick = () => openChat(name);
            listEl.appendChild(div);
        }

        function updateTotalFooter() {
            const total = Object.keys(allChatsData).length;
            document.getElementById('footerLabel').textContent = "Status Backup";
            document.getElementById('totalContactsText').textContent = `${total} Kontak Dibackup`;
        }

        function setView(view) {
            const pContact = document.getElementById('contactPanel'), pSearch = document.getElementById('searchPanel'), pChat = document.getElementById('chatPanel'), pUpload = document.getElementById('uploadPanel');
            const btnBack = document.getElementById('btnBack'), title = document.getElementById('headerTitle'), subtitle = document.getElementById('headerSubtitle');
            const searchCounter = document.getElementById('searchCounter'), btnNavUp = document.getElementById('btnNavUp'), btnNavDown = document.getElementById('btnNavDown'), searchInput = document.getElementById('searchInput');

            pContact.style.display = 'none'; pSearch.style.display = 'none'; pChat.style.display = 'none'; pUpload.style.display = 'none';

            if (view === 'contacts') {
                pContact.style.display = 'block'; searchCounter.style.display = 'none'; btnNavUp.style.display = 'none'; btnNavDown.style.display = 'none'; searchInput.placeholder = 'Cari...';
                btnBack.style.display = 'none'; title.textContent = "WhatsApp Arsip"; subtitle.textContent = "Daftar Percakapan"; currentActiveContact = null; resetSearchWidget(); updateTotalFooter();
            } else if (view === 'search') {
                pSearch.style.display = 'block'; searchCounter.style.display = 'none'; btnNavUp.style.display = 'none'; btnNavDown.style.display = 'none';
                btnBack.style.display = 'none'; title.textContent = "Hasil Pencarian"; subtitle.textContent = "Semua obrolan"; currentActiveContact = null;
            } else if (view === 'chat') {
                pChat.style.display = 'flex'; searchCounter.style.display = 'inline'; btnNavUp.style.display = 'inline-block'; btnNavDown.style.display = 'inline-block'; searchInput.placeholder = 'Cari chat...';
                btnBack.style.display = 'flex'; subtitle.textContent = "Online (Arsip)";
            } else if (view === 'upload') {
                pUpload.style.display = 'block'; searchCounter.style.display = 'none'; btnNavUp.style.display = 'none'; btnNavDown.style.display = 'none';
                btnBack.style.display = 'flex'; title.textContent = "Upload ke GitHub"; subtitle.textContent = "Konversi ZIP/TXT ke JSON";
                document.getElementById('footerLabel').textContent = "Status Upload"; document.getElementById('totalContactsText').textContent = "Siap Upload";
            }
            currentView = view;
        }

        function toggleUploadView() { currentView === 'upload' ? setView('contacts') : setView('upload'); }
        function goBack() { document.getElementById('searchInput').value = ''; setView('contacts'); }
        function resetSearchWidget() { searchMatches = []; currentMatchIndex = -1; document.getElementById('searchCounter').textContent = '0/0'; }

        function handleSearch() {
            if (currentView === 'chat' && currentActiveContact) return handleChatSearch();
            const keyword = document.getElementById('searchInput').value.trim().toLowerCase();
            if (keyword.length < 2) return setView('contacts');

            setView('search');
            const resultList = document.getElementById('searchResultList');
            resultList.innerHTML = '';
            let tempResults = [];

            for (let [contactName, chats] of Object.entries(allChatsData)) {
                if (!Array.isArray(chats)) continue;
                chats.forEach((chat, index) => {
                    const msg = (chat.message || '').toLowerCase(), snd = (chat.sender || '').toLowerCase();
                    if (msg.includes(keyword) || snd.includes(keyword)) tempResults.push({ contactName, chat, index });
                });
            }

            tempResults.sort((a, b) => {
                const timeA = parseWATimestamp(a.chat.date, a.chat.time), timeB = parseWATimestamp(b.chat.date, b.chat.time);
                return timeA !== timeB ? timeB - timeA : b.index - a.index;
            });

            document.getElementById('footerLabel').textContent = "Pencarian Global";
            document.getElementById('totalContactsText').textContent = `${tempResults.length} Pesan Ditemukan`;

            if (tempResults.length === 0) { resultList.innerHTML = '<div class="empty-state">Tidak ada pesan yang cocok.</div>'; return; }

            tempResults.forEach(res => {
                const div = document.createElement('div');
                div.className = 'wa-contact-item';
                const regex = new RegExp(`(${escapeRegExp(keyword)})`, "gi");
                const highlightedMsg = escapeHTML(res.chat.message || '').replace(regex, `<span class="highlight-match">$1</span>`);

                div.innerHTML = `
                    <div class="wa-contact-name" style="color: var(--wa-primary); font-size:13px;">
                        <span>${escapeHTML(res.contactName)}</span>
                        <span class="wa-contact-time">${escapeHTML(res.chat.date || '')} ${escapeHTML(res.chat.time || '')}</span>
                    </div>
                    <div class="wa-contact-msg">
                        <strong>${escapeHTML(res.chat.sender)}:</strong> ${highlightedMsg}
                    </div>
                `;
                div.onclick = () => { targetScrollIndex = res.index; openChat(res.contactName, keyword); };
                resultList.appendChild(div);
            });
        }

        function handleChatSearch() {
            if (currentView !== 'chat' || !currentActiveContact) return;
            const keyword = document.getElementById('searchInput').value.trim().toLowerCase();
            const chats = allChatsData[currentActiveContact] || [];
            searchMatches = [];

            if (keyword.length > 0) {
                chats.forEach((chat, index) => {
                    const msg = (chat.message || '').toLowerCase(), snd = (chat.sender || '').toLowerCase();
                    if (msg.includes(keyword) || snd.includes(keyword)) searchMatches.push(index);
                });
            }

            if (searchMatches.length > 0) {
                currentMatchIndex = searchMatches.length - 1;
                updateSearchCounterDisplay(); renderChatMessages(currentActiveContact, keyword); scrollToMatch(currentMatchIndex);
            } else {
                currentMatchIndex = -1; updateSearchCounterDisplay(); renderChatMessages(currentActiveContact, keyword.length > 0 ? keyword : null);
            }
        }

        function navigateSearch(direction) {
            if (searchMatches.length === 0) return;
            currentMatchIndex += direction;
            if (currentMatchIndex < 0) currentMatchIndex = searchMatches.length - 1;
            else if (currentMatchIndex >= searchMatches.length) currentMatchIndex = 0;
            updateSearchCounterDisplay(); scrollToMatch(currentMatchIndex);
        }

        function updateSearchCounterDisplay() {
            const counterEl = document.getElementById('searchCounter');
            counterEl.textContent = searchMatches.length === 0 ? '0/0' : `${currentMatchIndex + 1}/${searchMatches.length}`;
        }

        function scrollToMatch(matchIdx) {
            if (matchIdx < 0 || matchIdx >= searchMatches.length) return;
            const targetEl = document.getElementById(`msg-${searchMatches[matchIdx]}`);
            if (targetEl) {
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                document.querySelectorAll('.message-bubble').forEach(el => el.style.outline = "none");
                targetEl.style.outline = "2px solid #ff9800";
            }
        }

        function openChat(contactName, keywordToHighlight = null) {
            currentActiveContact = contactName; document.getElementById('headerTitle').textContent = contactName;
            resetSearchWidget(); setView('chat');
            if (keywordToHighlight) { document.getElementById('searchInput').value = keywordToHighlight; handleChatSearch(); } 
            else { document.getElementById('searchInput').value = ''; renderChatMessages(contactName); }
            setTimeout(() => {
                const chatPanel = document.getElementById('chatPanel');
                if (targetScrollIndex !== -1) {
                    const targetEl = document.getElementById(`msg-${targetScrollIndex}`);
                    if (targetEl) { targetEl.scrollIntoView({ behavior: 'auto', block: 'center' }); targetEl.style.outline = "2px solid #ff9800"; }
                    targetScrollIndex = -1;
                } else if (!keywordToHighlight) { chatPanel.scrollTop = chatPanel.scrollHeight; }
            }, 50);
        }

        function renderChatMessages(contactName, keywordToHighlight = null) {
            const chatPanel = document.getElementById('chatPanel'); chatPanel.innerHTML = '';
            const chats = allChatsData[contactName] || [];

            chats.forEach((chat, index) => {
                const sender = chat.sender || "Sistem", messageText = chat.message || '', isMe = sender.trim().toLowerCase() === "w";
                let displayMsg = escapeHTML(messageText);

                if (keywordToHighlight) {
                    const regex = new RegExp(`(${escapeRegExp(keywordToHighlight)})`, "gi");
                    displayMsg = displayMsg.replace(regex, `<span class="highlight-match">$1</span>`);
                }

                const div = document.createElement('div');
                div.className = `message-bubble ${isMe ? 'outgoing' : 'incoming'}`;
                div.id = `msg-${index}`;
                div.innerHTML = `
                    ${!isMe ? `<div class="message-sender">${escapeHTML(sender)}</div>` : ''}
                    <div>${displayMsg}</div>
                    <div class="message-time">${escapeHTML(chat.date || '')} ${escapeHTML(chat.time || '')}</div>
                `;
                chatPanel.appendChild(div);
            });

            if (keywordToHighlight) {
                document.getElementById('footerLabel').textContent = "Pencarian Chat Ini";
                document.getElementById('totalContactsText').textContent = `${searchMatches.length} Pesan Ditemukan`;
            } else {
                document.getElementById('footerLabel').textContent = "Total Pesan Chat";
                document.getElementById('totalContactsText').textContent = `${chats.length} Pesan`;
            }
        }

        function utf8ToBase64(str) {
            const bytes = new TextEncoder().encode(str); let binary = ''; const len = bytes.byteLength, chunkSize = 16384;
            for (let i = 0; i < len; i += chunkSize) { const chunk = bytes.subarray(i, Math.min(i + chunkSize, len)); binary += String.fromCharCode.apply(null, chunk); }
            return btoa(binary);
        }

        async function processAndUploadToGitHub() {
            const token = document.getElementById('ghToken').value.trim(), owner = document.getElementById('ghOwner').value.trim(), repo = document.getElementById('ghRepo').value.trim();
            let fileName = document.getElementById('ghFileName').value.trim(); const fileInput = document.getElementById('chatFileInput');
            const statusBox = document.getElementById('uploadStatusBox');
            statusBox.style.display = 'block'; statusBox.className = 'wa-status-box'; statusBox.textContent = 'Memproses file...';

            if (!token || !owner || !repo || fileInput.files.length === 0) { statusBox.className = 'wa-status-box error'; statusBox.textContent = 'Lengkapi Token, Owner, Repo, dan Pilih File!'; return; }
            const uploadedFile = fileInput.files[0];
            if (!fileName) fileName = uploadedFile.name.replace(/\.(zip|txt)$/i, '') + '.json';
            else if (!fileName.endsWith('.json')) fileName += '.json';

            try {
                let txtContent = "";
                if (uploadedFile.name.endsWith('.zip')) {
                    if (typeof JSZip === 'undefined') throw new Error("Library JSZip belum siap.");
                    const zip = await JSZip.loadAsync(uploadedFile);
                    let txtFileInZip = Object.keys(zip.files).find(name => name.endsWith('.txt'));
                    if (!txtFileInZip) throw new Error("File .txt tidak ditemukan di dalam ZIP");
                    txtContent = await zip.files[txtFileInZip].async("string");
                } else { txtContent = await uploadedFile.text(); }

                const chatsParsed = parseWhatsAppTextToJson(txtContent);
                if (chatsParsed.length === 0) throw new Error("Pesan tidak dapat dibaca/kosong.");

                const jsonFinal = JSON.stringify({ chats: chatsParsed }, null, 2);
                statusBox.textContent = `Berhasil memisah ${chatsParsed.length} pesan. Mengunggah ke GitHub...`;

                const encodedContent = utf8ToBase64(jsonFinal);
                const ghApiUrl = `https://api.github.com/repos/${owner}/${repo}/contents/${encodeURIComponent(fileName)}`;
                const authHeader = token.startsWith('Bearer ') || token.startsWith('token ') ? token : `Bearer ${token}`;
                let sha = "";
                try { const getRes = await fetch(ghApiUrl, { headers: { 'Authorization': authHeader } }); if (getRes.ok) { const existingData = await getRes.json(); sha = existingData.sha; } } catch (e) { console.log("File baru."); }

                const putRes = await fetch(ghApiUrl, {
                    method: 'PUT',
                    headers: { 'Authorization': authHeader, 'Content-Type': 'application/json', 'Accept': 'application/vnd.github.v3+json' },
                    body: JSON.stringify({ message: `Upload chat backup ${fileName}`, content: encodedContent, sha: sha ? sha : undefined })
                });

                if (!putRes.ok) { const errData = await putRes.json().catch(() => ({ message: putRes.statusText })); throw new Error(`GitHub API Error: ${errData.message || 'Gagal'}`); }
                statusBox.className = 'wa-status-box success'; statusBox.textContent = `Berhasil diupload! (${chatsParsed.length} pesan terpisah ke ${fileName})`;
            } catch (err) { statusBox.className = 'wa-status-box error'; statusBox.textContent = `${err.message}`; }
        }

        function parseWhatsAppTextToJson(text) {
            const lines = text.split('\n'), chats = [];
            const regex = /^\[?(\d{1,2}[\/\.-]\d{1,2}[\/\.-]\d{2,4})[,\s]+(\d{1,2}[:\.]\d{2}(?:[:\.]\d{2})?)\s?(?:AM|PM|am|pm)?\]?\s*[\-–~]?\s*([^:]+):\s*(.*)$/;
            lines.forEach(line => {
                const cleanLine = line.replace(/[\u200e\u200f\u202a-\u202e]/g, '').trim(); if (!cleanLine) return;
                const match = cleanLine.match(regex);
                if (match) chats.push({ date: match[1], time: match[2], sender: match[3].trim(), message: match[4].trim() });
                else if (chats.length > 0) chats[chats.length - 1].message += '\n' + cleanLine;
            });
            return chats;
        }

        function escapeHTML(str) { return String(str).replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)); }
        function escapeRegExp(string) { return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

        initViewer();
    </script>
