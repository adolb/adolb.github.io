    // --- FUNGSI EKSTRAK KALIMAT & HIGHLIGHT BOLD ---
    // =======================================================
    function getSnippetHighlight(text, query) {
        if (!text) return "";
        // Bersihkan dari tag html kotor jika ada sebelum di match
        let cleanText = text.replace(/<[^>]*>?/gm, ''); 
        // Pisahkan teks berdasarkan kalimat (titik, tanya, seru, atau ganti baris)
        const sentences = cleanText.match(/[^.!?\n]+[.!?\n]*/g) || [cleanText];
        
        let matched = sentences.find(s => s.toLowerCase().includes(query.toLowerCase()));
        
        if (matched) {
            matched = matched.trim();
            // Wrap kata pencarian dengan <strong> yang ditambahkan style bold sesuai primary text
            const regex = new RegExp(`(${query})`, 'gi');
            return matched.replace(regex, '<strong style="color:var(--text-primary); font-weight:700;">$1</strong>');
        }
        // Fallback jika tidak ditemukan (mungkin nyangkut di judul)
        return escapeHTML(cleanText.substring(0, 60)) + "...";
    }

